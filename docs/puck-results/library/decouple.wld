// ddd-by-examples/library (commit 5225ff7): a modular monolith with two bounded contexts, catalogue (CRUD) and
// lending (hexagonal: model, application, infrastructure, web per aggregate), over a shared kernel, commons.
// Context declared from the README and the package layout, by someone who did not write the program.
// Axes, ranked by speed of change: commons > catalogue > model > application > {infrastructure, web} > wiring.
//   commons        the shared kernel: aggregates, commands, events and their publisher
//   catalogue      the catalogue context, CRUD; lending uses its identifiers (BookId, ISBN, BookType)
//   model          the domain model of lending, all aggregates
//   application    the use cases of lending (commands, handlers, policies)
//   infrastructure the persistence and read models of lending
//   web            the one controller
//   wiring         the Spring entry point and every @Configuration class, wherever it sits
axis commons        = [io.pillopl.library.commons.aggregates, io.pillopl.library.commons.commands,
                      io.pillopl.library.commons.events, io.pillopl.library.commons.events.publisher]
axis catalogue      = [io.pillopl.library.catalogue]
axis model          = [io.pillopl.library.lending.book.model, io.pillopl.library.lending.dailysheet.model,
                      io.pillopl.library.lending.librarybranch.model, io.pillopl.library.lending.patron.model,
                      io.pillopl.library.lending.patronprofile.model]
axis application    = [io.pillopl.library.lending.book.application, io.pillopl.library.lending.patron.application.checkout,
                      io.pillopl.library.lending.patron.application.hold]
axis infrastructure = [io.pillopl.library.lending.book.infrastructure, io.pillopl.library.lending.dailysheet.infrastructure,
                      io.pillopl.library.lending.patron.infrastructure, io.pillopl.library.lending.patronprofile.infrastructure]
axis web            = [io.pillopl.library.lending.patronprofile.web]
axis wiring         = [io.pillopl.library, io.pillopl.library.lending,
                      io.pillopl.library.catalogue.CatalogueConfiguration, io.pillopl.library.catalogue.CatalogueDatabaseConfig,
                      io.pillopl.library.commons.events.publisher.DomainEventsConfig,
                      io.pillopl.library.lending.book.infrastructure.BookConfiguration,
                      io.pillopl.library.lending.dailysheet.infrastructure.DailySheetConfiguration,
                      io.pillopl.library.lending.patron.infrastructure.PatronConfiguration,
                      io.pillopl.library.lending.patronprofile.infrastructure.PatronProfileConfiguration,
                      io.pillopl.library.lending.patronprofile.web.WebConfiguration]

// Generated by the ranking (the Dependency Rule): each axis hidden from the axes that change less often.

// The speed of change (README: shared kernel, catalogue, lending model, application, infrastructure and web), slowest first.
speed commons < catalogue < model < application < infrastructure, web < wiring;

friend wiring of all;   // the composition root must see everything to assemble it
friend tests of all;    // the tests are neither wiring nor an axis

// BEGIN optional: ADP, the two unordered adapter axes kept apart.
apart infrastructure, web;
// END optional
