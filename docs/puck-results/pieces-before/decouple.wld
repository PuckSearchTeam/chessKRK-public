// The engine just before the piece catalogue redesign (commit 79a367d): the concrete pieces are the
// constants of the PieceType enum in the domain. Declaring "which pieces exist" as an axis of its own
// makes the five constants foreign to PieceType (paper, Section 5.4).
axis rules      = [org.chesskrk.domain]
axis policy     = [org.chesskrk.application.port.in, org.chesskrk.application.port.out]
axis strategies = [org.chesskrk.application.usecase]
axis valuation  = [org.chesskrk.adapter.tablebase, org.chesskrk.adapter.heuristic]
axis pieces     = [org.chesskrk.domain.PieceType.KING,
                  org.chesskrk.domain.PieceType.QUEEN,
                  org.chesskrk.domain.PieceType.ROOK,
                  org.chesskrk.domain.PieceType.BISHOP,
                  org.chesskrk.domain.PieceType.KNIGHT]
axis protocol   = [org.chesskrk.adapter.uci]
axis wiring     = [org.chesskrk.infrastructure]

// The speed of change (paper, Section 4.3), slowest axis first; the clauses of the Dependency Rule follow:
// each axis is hidden from the axes that change less often.
speed rules < policy < strategies < valuation, pieces, protocol < wiring;

// Decisions of the architect.
friend wiring of all;   // the composition root must see everything to assemble it
friend tests of all;    // the tests are neither wiring nor an axis

// BEGIN optional: ADP. Keeping the three unordered axes apart hides each from the others, so no pair is
// permitted in both directions, the permitted relation between axes is acyclic and every cycle of uses
// through two axes contains a violation (paper, Proposition 1).
apart valuation, pieces, protocol;
// END optional: ADP

// The strict reading: no concrete piece names another.
separate pieces;
