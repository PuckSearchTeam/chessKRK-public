// buckpal (thombergs/buckpal, commit dc819c6), the example of "Get Your Hands Dirty on Clean Architecture".
// Context declared from the README and the package layout, by someone who did not write the program.
// Axes, ranked by speed of change: model > ports > commons > services > {web, persistence} > wiring.
//   model       the domain model (Account, Activity, ActivityWindow, Money); changes when the business does
//   ports       the use cases offered (port.in) and the needs (port.out): the application's contract
//   commons     the project's stereotype annotations and validation helper: framework glue
//   services    the use case implementations, ranked below the adapters as Clean Architecture ranks use cases
//   web         the incoming adapter (REST controller)
//   persistence the outgoing adapter (JPA entities, mapper, repositories, lock)
//   wiring      Spring Boot entry point and configuration, in the root package
axis model       = [io.reflectoring.buckpal.application.domain.model]
axis ports       = [io.reflectoring.buckpal.application.port.in, io.reflectoring.buckpal.application.port.out]
axis commons     = [io.reflectoring.buckpal.common, io.reflectoring.buckpal.common.validation]
axis services    = [io.reflectoring.buckpal.application.domain.service]
axis web         = [io.reflectoring.buckpal.adapter.in.web]
axis persistence = [io.reflectoring.buckpal.adapter.out.persistence]
axis wiring      = [io.reflectoring.buckpal]

// Generated by the ranking (the Dependency Rule): each axis hidden from the axes that change less often.

// The speed of change (README: domain, ports, common, services, adapters, the Spring application), slowest first.
// The services rank below the two adapters since 2026-10-20, as the engine's strategies do (paper, Section 5.1).
speed model < ports < commons < services < web, persistence < wiring;

friend wiring of all;   // the composition root must see everything to assemble it
friend tests of all;    // the tests are neither wiring nor an axis
separate ports;         // incoming and outgoing ports do not depend on each other (the project's own rule)

// BEGIN optional: ADP, the two unordered adapter axes kept apart (the author's rule that adapters do not depend on each other).
apart web, persistence;
// END optional
