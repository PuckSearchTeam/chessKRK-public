// ArgoUML 0.24, the published architecture of Brunet et al. (2012), as distributed with s4rdm3x (argouml.sysmdl):
// 19 modules mapped to packages by regular expression, and the relations each module is allowed to have.
// Packages no module maps are outside the context: org.argouml.kernel, org.argouml.pattern.cognitive.critics, org.argouml.uml, org.argouml.uml.cognitive, org.argouml.uml.cognitive.checklist, org.argouml.uml.cognitive.critics, org.argouml.uml.generator, org.argouml.uml.generator.ui, org.argouml.uml.notation, org.argouml.uml.notation.java, org.argouml.uml.notation.uml, org.argouml.uml.ui, org.argouml.uml.ui.behavior.activity_graphs, org.argouml.uml.ui.behavior.collaborations, org.argouml.uml.ui.behavior.common_behavior, org.argouml.uml.ui.behavior.state_machines, org.argouml.uml.ui.behavior.use_cases, org.argouml.uml.ui.foundation.core, org.argouml.uml.ui.foundation.extension_mechanisms, org.argouml.uml.ui.model_management, org.argouml.uml.util.namespace, org.argouml.util, org.argouml.util.logging, org.argouml.util.osdep, org.argouml.util.osdep.win32.
// This file states only the layering the allowed relations imply: each module at the depth of its longest chain
// of allowed uses, the layers as a speed chain, slowest first. What an order alone says.
axis application          = [org.argouml.application, org.argouml.application.configuration, org.argouml.application.events, org.argouml.application.helpers, org.argouml.application.security]
axis diagrams             = [org.argouml.uml.diagram, org.argouml.uml.diagram.activity, org.argouml.uml.diagram.activity.layout, org.argouml.uml.diagram.activity.ui, org.argouml.uml.diagram.collaboration, org.argouml.uml.diagram.collaboration.ui, org.argouml.uml.diagram.deployment, org.argouml.uml.diagram.deployment.ui, org.argouml.uml.diagram.layout, org.argouml.uml.diagram.sequence, org.argouml.uml.diagram.sequence.ui, org.argouml.uml.diagram.state, org.argouml.uml.diagram.state.ui, org.argouml.uml.diagram.static_structure, org.argouml.uml.diagram.static_structure.layout, org.argouml.uml.diagram.static_structure.ui, org.argouml.uml.diagram.ui, org.argouml.uml.diagram.use_case, org.argouml.uml.diagram.use_case.ui]
axis notation             = [org.argouml.notation, org.argouml.notation.ui]
axis explorer             = [org.argouml.ui.explorer, org.argouml.ui.explorer.rules]
axis codeGeneration       = [org.argouml.language.ui]
axis reverseEngineering   = [org.argouml.uml.reveng, org.argouml.uml.reveng.java, org.argouml.uml.reveng.ui]
axis persistence          = [org.argouml.persistence]
axis moduleLoader         = [org.argouml.application.api, org.argouml.application.modules, org.argouml.moduleloader]
axis gui                  = [org.argouml.ui, org.argouml.ui.cmd, org.argouml.ui.targetmanager]
axis model                = [org.argouml.model]
axis internationalization = [org.argouml.i18n]
axis swingExtensions      = [org.argouml.swingext]
axis ocl                  = [org.argouml.ocl]
axis critics              = [org.argouml.cognitive, org.argouml.cognitive.checklist, org.argouml.cognitive.checklist.ui, org.argouml.cognitive.critics, org.argouml.cognitive.critics.ui, org.argouml.cognitive.ui]
axis javaCodeGeneration   = [org.argouml.language.java.cognitive.critics, org.argouml.language.java.generator]
speed model, internationalization, swingExtensions < notation, reverseEngineering, persistence, moduleLoader, gui < diagrams, explorer, codeGeneration, ocl, critics < javaCodeGeneration < application;
friend tests of all;
