// ADP, the violating version: reports and export use each other. The two axes are unordered: the ranking
// alone generates no clause between them, so the cycle is a violation only if the architect decides a
// direction (here: export may use reports, not the reverse), which is the optional block.
axis reports = [martin.adp.reports]
axis export  = [martin.adp.export]
// generated by the ranking: nothing, the axes are unordered
// BEGIN optional: ADP, the decision that makes the permitted relation acyclic
hide export from reports;
// END optional: ADP
